{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openai.local/schemas/project-capsule-orchestrator/thread-plan.schema.json",
  "title": "Project Capsule Thread Plan",
  "description": "Strict interchange contract between Project Capsule Orchestrator and a project-thread creation plugin.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_name",
    "project_cwd",
    "generated_at",
    "project_summary",
    "selected_strategy",
    "critical_path",
    "assumptions",
    "unresolved_questions",
    "safety_gates",
    "milestones"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0",
      "description": "Version of this thread-plan contract."
    },
    "project_name": {
      "$ref": "#/$defs/nonBlankString"
    },
    "project_cwd": {
      "$ref": "#/$defs/projectDirectory"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time",
      "description": "RFC 3339 timestamp with a UTC designator or numeric UTC offset."
    },
    "project_summary": {
      "type": "string",
      "minLength": 10,
      "maxLength": 2000,
      "pattern": "\\S"
    },
    "selected_strategy": {
      "type": "string",
      "enum": [
        "ROBUST",
        "LEVERAGE",
        "BREAKTHROUGH"
      ]
    },
    "critical_path": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/milestoneId"
      }
    },
    "assumptions": {
      "$ref": "#/$defs/nonBlankStringArray"
    },
    "unresolved_questions": {
      "$ref": "#/$defs/nonBlankStringArray"
    },
    "safety_gates": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/safetyGate"
      }
    },
    "milestones": {
      "type": "array",
      "minItems": 3,
      "maxItems": 12,
      "items": {
        "$ref": "#/$defs/milestone"
      }
    }
  },
  "$defs": {
    "nonBlankString": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000,
      "pattern": "\\S"
    },
    "nonBlankStringArray": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/nonBlankString"
      }
    },
    "nonEmptyStringArray": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/nonBlankString"
      }
    },
    "milestoneId": {
      "type": "string",
      "pattern": "^M(?:0|[1-9][0-9]?)$"
    },
    "projectDirectory": {
      "type": "string",
      "minLength": 2,
      "maxLength": 4096,
      "pattern": "^(?:[A-Za-z]:[\\\\/](?:[^\\u0000\\\\/]+[\\\\/])*[^\\u0000\\\\/]+|/(?:[^\\u0000/]+/)*[^\\u0000/]+|\\\\\\\\[^\\u0000\\\\/]+\\\\[^\\u0000\\\\/]+\\\\[^\\u0000\\\\/].*)$",
      "description": "Absolute Windows, POSIX, or UNC project directory below a filesystem or share root."
    },
    "projectEntry": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^(?![A-Za-z]:[\\\\/])(?![\\\\/])(?!.*(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$))[^\\u0000]*\\S[^\\u0000]*$",
      "description": "A project-relative nonblank file, directory, or glob expression with no NUL byte or parent-directory traversal segment."
    },
    "projectEntryArray": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/projectEntry"
      }
    },
    "nonEmptyProjectEntryArray": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/projectEntry"
      }
    },
    "risk": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "description",
        "severity",
        "likelihood",
        "mitigation"
      ],
      "properties": {
        "description": {
          "$ref": "#/$defs/nonBlankString"
        },
        "severity": {
          "type": "string",
          "enum": [
            "HIGH",
            "MEDIUM",
            "LOW"
          ]
        },
        "likelihood": {
          "type": "string",
          "enum": [
            "HIGH",
            "MEDIUM",
            "LOW"
          ]
        },
        "mitigation": {
          "$ref": "#/$defs/nonBlankString"
        }
      }
    },
    "safetyGate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gate_id",
        "description",
        "applies_to",
        "approval_required",
        "release_condition",
        "status"
      ],
      "properties": {
        "gate_id": {
          "type": "string",
          "pattern": "^G[A-Za-z0-9._-]+$"
        },
        "description": {
          "$ref": "#/$defs/nonBlankString"
        },
        "applies_to": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/milestoneId"
          }
        },
        "approval_required": {
          "type": "boolean"
        },
        "release_condition": {
          "$ref": "#/$defs/nonBlankString"
        },
        "status": {
          "type": "string",
          "enum": [
            "OPEN",
            "SATISFIED",
            "WAIVED"
          ]
        }
      }
    },
    "milestone": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "milestone_id",
        "name",
        "goal",
        "rationale",
        "dependencies",
        "initial_status",
        "critical_path",
        "parallel_group",
        "execution_mode",
        "project_cwd",
        "required_files",
        "allowed_paths",
        "forbidden_paths",
        "outputs",
        "acceptance_criteria",
        "validation_commands",
        "risks",
        "stop_conditions",
        "capsule_updates",
        "initial_prompt"
      ],
      "properties": {
        "milestone_id": {
          "$ref": "#/$defs/milestoneId"
        },
        "name": {
          "type": "string",
          "minLength": 4,
          "maxLength": 120,
          "pattern": "^M(?:0|[1-9][0-9]?)\\s+\\S",
          "description": "Full thread title in the form 'M0 concise task name'; the validator also requires the prefix to equal milestone_id."
        },
        "goal": {
          "$ref": "#/$defs/nonBlankString"
        },
        "rationale": {
          "$ref": "#/$defs/nonBlankString"
        },
        "dependencies": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/milestoneId"
          }
        },
        "initial_status": {
          "type": "string",
          "enum": [
            "DRAFT",
            "READY",
            "WAITING",
            "BLOCKED",
            "ACTIVE",
            "REVIEW",
            "DONE",
            "ARCHIVED"
          ]
        },
        "critical_path": {
          "type": "boolean"
        },
        "parallel_group": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 80,
              "pattern": "\\S"
            }
          ]
        },
        "execution_mode": {
          "type": "string",
          "enum": [
            "readonly",
            "local",
            "worktree",
            "hardware-gated",
            "production-gated"
          ]
        },
        "project_cwd": {
          "$ref": "#/$defs/projectDirectory"
        },
        "required_files": {
          "$ref": "#/$defs/nonEmptyProjectEntryArray"
        },
        "allowed_paths": {
          "$ref": "#/$defs/projectEntryArray"
        },
        "forbidden_paths": {
          "$ref": "#/$defs/projectEntryArray"
        },
        "outputs": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "acceptance_criteria": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "validation_commands": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "risks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/risk"
          }
        },
        "stop_conditions": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "capsule_updates": {
          "$ref": "#/$defs/nonEmptyProjectEntryArray"
        },
        "initial_prompt": {
          "type": "string",
          "minLength": 100,
          "maxLength": 20000,
          "pattern": "\\S"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "execution_mode": {
                "const": "readonly"
              }
            },
            "required": [
              "execution_mode"
            ]
          },
          "then": {
            "properties": {
              "allowed_paths": {
                "type": "array",
                "maxItems": 0
              }
            }
          },
          "else": {
            "properties": {
              "allowed_paths": {
                "type": "array",
                "minItems": 1
              }
            }
          }
        }
      ]
    }
  }
}
